#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            layers = <0 1 2 3 4>;
        };

        back {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
            layers = <0 2 1 3 4>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp Q    &kp W  &kp E         &kp R  &kp T        &kp Y      &kp U            &kp I            &kp O              &kp P
&kp A    &kp S  &kp D         &kp F  &kp G        &kp H      &hm RIGHT_GUI J  &hm RIGHT_ALT K  &hm RIGHT_SHIFT L  &hm SEMI SQT
&lt 4 Z  &kp X  &kp C         &kp V  &lt 5 B      &kp N      &kp M            &kp COMMA        &kp PERIOD         &hm RCTRL SLASH
                &kp LEFT_GUI  &mo 1  &kp SPACE    &kp ENTER  &mo 2            &kp RIGHT_SHIFT
            >;

            label = "QWERTY";
        };

        LOWER {
            bindings = <
&kp N1     &kp N2  &kp N3         &kp N4         &kp N5       &kp N6          &kp N7  &kp N8         &kp N9            &kp N0
&kp GRAVE  &none   &none          &none          &kp LC(A)    &kp MINUS       &none   &none          &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&none      &none   &kp LS(LC(C))  &kp LS(LC(V))  &none        &none           &none   &none          &none             &kp NON_US_BACKSLASH
                   &trans         &trans         &trans       &kp LEFT_SHIFT  &mo 3   &kp RIGHT_GUI
            >;

            label = "LOWER";
        };

        ADJUST {
            bindings = <
&kp ESC  &none  &none   &none   &none        &kp DELETE         &kp HOME        &kp UP_ARROW    &kp END          &kp BACKSPACE
&kp TAB  &none  &none   &none   &none        &kp LS(SEMICOLON)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PRINTSCREEN
&none    &none  &none   &none   &kp EQUAL    &kp LG(SPACE)      &kp PAGE_UP     &none           &kp PAGE_DOWN    &trans
                &trans  &trans  &trans       &trans             &trans          &trans
            >;

            label = "ADJUST";
        };

        MACRO {
            label = "MACRO";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans         &trans                &trans                 &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SINGLE_QUOTE
&trans  &trans  &trans  &trans  &trans    &trans  &kp LESS_THAN  &kp GREATER_THAN      &trans                 &trans
                &trans  &trans  &trans    &trans  &trans         &trans
            >;
        };

        FUNC {
            label = "FUNC";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7  &kp F8  &kp F9           &kp F10
&none   &none   &none   &none   &none     &none   &none   &none   &kp F11          &kp F12
&none   &none   &none   &none   &none     &none   &none   &none   &kp RIGHT_SHIFT  &kp RCTRL
                &trans  &trans  &trans    &trans  &none   &none
            >;
        };

        BLUETOOTH {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans    &bt BT_CLR      &trans  &trans  &trans  &bt BT_CLR_ALL
&trans        &trans        &trans        &trans  &trans    &trans          &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans  &trans    &studio_unlock  &trans  &trans  &trans  &trans
                            &trans        &trans  &trans    &trans          &trans  &trans
            >;
        };
    };
};
